# Runtime mode. Allowed: development | test | production
NODE_ENV=development

# Port the HTTP server listens on. Allowed: 1-65535
PORT=3000

# Comma-separated CORS allowlist of exact origins (scheme://host:port, no path, no wildcard).
# Example: https://app.kfa.example,https://admin.kfa.example
APP_ORIGINS=http://localhost:3001

# Pino log level. Allowed: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of the API. 0 means no proxy is trusted.
TRUSTED_PROXY_COUNT=0

# Maximum accepted JSON/form body size in bytes. Allowed: 1024-1048576
BODY_LIMIT_BYTES=102400

# Runtime PostgreSQL URL (role kfa_app: no DDL privileges). Never commit real credentials.
# Production must include sslmode=require (or verify-ca / verify-full).
DATABASE_URL=postgresql://kfa_app:dev-only-change-me@127.0.0.1:5432/kfa?schema=public

# Migration-only PostgreSQL URL (role kfa_migrator). Used by the Prisma CLI only.
# Optional for the running app; remove it from deployed runtime environments.
MIGRATION_DATABASE_URL=postgresql://kfa_migrator:dev-only-change-me@127.0.0.1:5432/kfa?schema=public

# Key for HMAC-SHA256 hashing of client IPs in the audit log (min 32 chars).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUDIT_HMAC_KEY=dev-only-change-me-0123456789abcdef
