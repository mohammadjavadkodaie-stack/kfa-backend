# Copy to deploy/.env.production, fill every placeholder, chmod 600, and pass with --env-file.
# Generate random secrets with: openssl rand -base64 48 (keys requiring exact base64 lengths are noted).
NODE_ENV=production # Runtime mode; must be production.
SITE_DOMAIN=example.com # Apex public hostname.
WWW_REDIRECT_DOMAIN=www.example.com # Optional www hostname; leave empty to disable redirect.
ACME_EMAIL=ops@example.com # Caddy certificate notification address.
FRONTEND_CONTEXT=../../KFA-frontend # UNSURE: assumed sibling frontend path; adjust for deployment.
APP_URL=https://example.com # Frontend public origin, read by the frontend at runtime.
SESSION_SECRET=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48; signs the frontend session cookie.
BACKEND_INTERNAL_URL=http://backend:3001 # Frontend API base URL; a build argument baked into the frontend image.
TURNSTILE_SITE_KEY=0x4AAAAAAA-frontend-placeholder # Frontend public Turnstile site key.
APP_ORIGINS=https://example.com # Exact browser origin allowlist, comma-separated if supported by env parser.
TRUSTED_PROXY_COUNT=1 # Exactly the real number of reverse proxies; one Caddy here.
LOG_LEVEL=info # Production log level.
BODY_LIMIT_BYTES=102400 # JSON body cap; document uploads are independently capped at 10 MiB.
PORT=3001 # Container API port.
CAPTCHA_PROVIDER=turnstile # Production captcha provider.
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET # Generate/store provider secret, not a local random value.
TURNSTILE_EXPECTED_HOSTNAME=example.com # Turnstile hostname allowlist.
EMAIL_PROVIDER=resend # Production email provider.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY # Create in Resend; never commit it.
EMAIL_FROM=KFA <no-reply@example.com> # Verified sender mailbox.
POSTGRES_USER=kfa # Database runtime user.
POSTGRES_DB=kfa # Database name.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD # openssl rand -base64 36.
DATABASE_URL=postgresql://kfa:REPLACE@postgres:5432/kfa?sslmode=require # App connection; use real URL-encoded password.
MIGRATION_DATABASE_URL=postgresql://kfa_migrator:REPLACE@postgres:5432/kfa?sslmode=require # Dedicated migration role URL.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD # openssl rand -base64 36.
REDIS_URL=rediss://default:REPLACE@redis:6379/0 # TLS/password URL; use a TLS-capable Redis endpoint in production.
AUDIT_HMAC_KEY=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48.
RATE_LIMIT_HMAC_KEY=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48; unique from every other key.
EMAIL_CODE_HMAC_KEY=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48.
ACCESS_TOKEN_SECRET=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48.
TOTP_ENC_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY # openssl rand -base64 32 then convert to base64url as required.
DOCUMENT_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY # openssl rand -base64 32; exactly 32 decoded bytes.
DOCUMENT_MASTER_KEY_ID=v1 # Current document key version.
DOCUMENT_VIEW_TOKEN_SECRET=REPLACE_WITH_UNIQUE_SECRET # openssl rand -base64 48.
S3_ENDPOINT=https://s3.example-provider.invalid # HTTPS S3-compatible endpoint; provider assumption is documented below.
S3_REGION=us-east-1 # Provider signing region.
S3_BUCKET=kfa-documents # Private encrypted document bucket.
S3_ACCESS_KEY_ID=REPLACE_WITH_DEDICATED_STORAGE_ACCESS_KEY # Least-privilege storage identity.
S3_SECRET_ACCESS_KEY=REPLACE_WITH_DEDICATED_STORAGE_SECRET # Provider secret.
S3_FORCE_PATH_STYLE=false # Set true only for providers requiring path-style addressing.
CLAMAV_HOST=clamav # Internal clamd service name.
CLAMAV_PORT=3310 # clamd INSTREAM port.
# Frontend runtime contract: APP_URL, SESSION_SECRET, LOG_LEVEL, CAPTCHA_PROVIDER, TURNSTILE_SITE_KEY, NODE_ENV and TRUSTED_PROXY_COUNT=1; its API base URL is the BACKEND_INTERNAL_URL build argument (default http://backend:3001).
# .gitignore ignores real .env files; this .env.production.example is intentionally tracked.
# UNSURE: S3 provider is intentionally generic because env.ts supports any HTTPS S3-compatible service.

# Payment providers (optional; a provider without its keys is simply absent).
# NOWPAYMENTS_API_KEY=REPLACE_WITH_NOWPAYMENTS_API_KEY
# NOWPAYMENTS_IPN_SECRET=REPLACE_WITH_NOWPAYMENTS_IPN_SECRET
# PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
# PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET
# PAYPAL_WEBHOOK_ID=REPLACE_WITH_PAYPAL_WEBHOOK_ID
# Publish the API on https://api.<domain> and point the frontend rewrite at it.
# BILLING_WEBHOOK_PUBLIC_URL=https://api.example.com
# BILLING_RETURN_URL=https://app.example.com/en/account/subscription/return
