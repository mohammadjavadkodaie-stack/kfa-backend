// KFA database schema (stage 2: auth foundation and append-only audit log).
//
// URL handling:
// - `directUrl` is used by the Prisma CLI / Migrate, so migrations always run
//   as the DDL-only role `kfa_migrator`.
// - `url` is only a fallback for tools that do not override it. The running app
//   always passes the validated DATABASE_URL (role `kfa_app`) explicitly in
//   PrismaService; it must never connect with the migrator credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

/// Tamper-evident audit trail. Append-only is enforced twice:
/// 1. the database trigger/privileges (prisma/migrations, db/roles.sql),
/// 2. AuditService, which exposes no update or delete operation.
///
/// `hash` = sha256(prevHash + canonical JSON of the immutable row fields).
/// `prevHash` references the previous row, forming a chain.
///
/// Chain-integrity indexes are NOT declared here on purpose: they are partial /
/// expression unique indexes (`audit_log_prev_hash_key`, `audit_log_single_genesis_key`)
/// that Prisma cannot express. They live in
/// prisma/migrations/20261028104500_audit_log_chain_integrity/migration.sql.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  requestId  String?  @map("request_id")
  ipHash     String?  @map("ip_hash")
  metadata   Json     @default("{}")
  prevHash   String?  @map("prev_hash")
  hash       String   @unique

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Role {
  USER
  ATHLETE
  ADMIN
  OWNER
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

enum ReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum DocumentKind {
  NATIONAL_ID
  MEDAL
  CERTIFICATE
}

enum DocumentStatus {
  ACTIVE
  DELETED
}

/// At most one row may hold the OWNER role. Prisma cannot express a partial
/// index, so the guarantee lives in raw SQL only:
/// `users_single_owner_key` is a unique index on a constant expression with
/// `WHERE role = 'OWNER'`, created by
/// prisma/migrations/20261107120000_single_owner_partial_index/migration.sql.
model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Optional since E2-a: an email-only account has no number. Still unique.
  phone            String?      @unique
  /// Stored normalized (lowercase, ASCII/punycode domain); NULL until linked.
  email            String?      @unique
  passwordHash     String?      @map("password_hash")
  emailVerifiedAt  DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  username         String       @unique
  role             Role         @default(USER)
  /// Permission to verify identities, granted independently of `role`.
  identityVerifier Boolean      @default(false) @map("identity_verifier")
  status           UserStatus   @default(ACTIVE)
  phoneVerifiedAt  DateTime?    @map("phone_verified_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  devices          Device[]
  sessions         Session[]
  totpCredential   TotpCredential?
  recoveryCodes    RecoveryCode[]
  athleteProfile   AthleteProfile?
  documents        IdentityDocument[]
  notifications    Notification[]
  subscriptions    Subscription[]
  photoReports     PhotoReport[]
  athleteFollows   AthleteFollow[] @relation("AthleteFollowFollower")
  photoLikes       PhotoLike[]
  competitionResults CompetitionResult[] @relation("CompetitionResultEnteredBy")
  @@map("users")
}

/// One profile per user. Minority is derived from `dateOfBirth` at read time and
/// never stored, and the row deliberately holds no national ID and no address:
/// the format and range rules live in the migration's CHECK constraints.
model AthleteProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  legalFirstName     String   @map("legal_first_name")
  legalLastName      String   @map("legal_last_name")
  dateOfBirth        DateTime @map("date_of_birth") @db.Date
  gender             Gender
  /// ISO 3166-1 alpha-2, uppercase.
  nationality        String   @db.VarChar(2)
  countryOfResidence String   @map("country_of_residence") @db.VarChar(2)
  city               String
  clubName           String?  @map("club_name")
  weightKg           Int?     @map("weight_kg")
  heightCm           Int?     @map("height_cm")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewStatus       ReviewStatus @default(DRAFT) @map("review_status")
  submittedAt       DateTime?    @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  reviewedById      String?      @map("reviewed_by_id") @db.Uuid
  rejectionReason   String?      @map("rejection_reason") @db.VarChar(500)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos             ProfilePhoto[]
  followers          AthleteFollow[] @relation("AthleteFollowFollowed")
  competitionResults CompetitionResult[]
  ranking            AthleteRanking?

  @@map("athlete_profiles")
}

enum ProfilePhotoStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn from public view by staff, either after approval or while still
  /// PENDING. Distinct from REJECTED: a rejection is a review outcome, a removal
  /// takes down a photo that may already have been published.
  REMOVED
}

/// The fixed reason codes a user may attach to a report.
enum PhotoReportReason {
  SPAM
  ABUSE
  NUDITY
  OTHER
}

/// One photo on an athlete's personal page. Like an identity document, the row
/// points at an encrypted blob - an opaque object key plus the envelope - and
/// never at a file name, a URL or the bytes themselves. `caption` is plain text
/// that the API sanitized and escaped before it was written; the CHECK
/// constraints and the withheld DELETE privilege live in the migration.
model ProfilePhoto {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athleteProfileId String             @map("athlete_profile_id") @db.Uuid
  /// Random UUID from createObjectKey(); never a user id, a name or an extension.
  objectKey        String             @unique @map("object_key")
  /// Sanitized, escaped and length-capped by the API. NULL when no caption was sent.
  caption          String?            @db.VarChar(1000)
  status           ProfilePhotoStatus @default(PENDING)
  contentType      String             @map("content_type")
  sizeBytes        Int                @map("size_bytes")
  /// Hex SHA-256 of the sanitized bytes that were encrypted.
  sha256           String             @db.Char(64)
  keyId            String             @map("key_id")
  wrappedDek       Bytes              @map("wrapped_dek")
  iv               Bytes
  authTag          Bytes              @map("auth_tag")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set only when a reviewer decides; NULL while the photo is PENDING.
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  athleteProfile   AthleteProfile     @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  reports          PhotoReport[]
  likes            PhotoLike[]

  @@index([athleteProfileId, status])
  @@index([athleteProfileId, createdAt(sort: Desc)])
  @@map("profile_photos")
}

/// One user's report about one profile photo.
///
/// A report is append-only: there is no update path and the runtime role never
/// deletes one. The unique pair (photo, reporter) makes a second report for the
/// same photo a no-op instead of a second row. `note` is plain text the API
/// trimmed and stripped of control characters; it is never returned to a
/// client, and the reporter's identity never leaves the staff read model.
model PhotoReport {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoId        String            @map("photo_id") @db.Uuid
  reporterUserId String            @map("reporter_user_id") @db.Uuid
  reason         PhotoReportReason
  note           String?           @db.VarChar(200)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  photo          ProfilePhoto      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reporter       User              @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([photoId, reporterUserId])
  @@index([photoId, createdAt])
  @@map("photo_reports")
}

/// One uploaded identity document. The row only points at a blob: it holds the
/// opaque object key, the encryption envelope and the digest of the scanned
/// bytes, never the bytes, a file name or a URL. The format CHECKs and the
/// withheld DELETE privilege live in the migration.
model IdentityDocument {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId  String         @map("owner_user_id") @db.Uuid
  kind         DocumentKind
  /// Random UUID from createObjectKey(); never a user id, name or extension.
  objectKey    String         @unique @map("object_key")
  contentType  String         @map("content_type")
  sizeBytes    Int            @map("size_bytes")
  /// Hex SHA-256 of the sanitized bytes that were encrypted.
  sha256       String         @db.Char(64)
  keyId        String         @map("key_id")
  wrappedDek   Bytes          @map("wrapped_dek")
  iv           Bytes
  authTag      Bytes          @map("auth_tag")
  status       DocumentStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  owner        User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status])
  @@map("identity_document")
}

model Device {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceKeyHash String    @unique @map("device_key_hash")
  uaHash        String?   @map("ua_hash")
  label         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]
  @@index([userId])
  @@map("devices")
}

model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceId      String         @map("device_id") @db.Uuid
  /// False when the session was created without an X-Device-Key header.
  deviceBound   Boolean        @default(true) @map("device_bound")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  lastUsedAt    DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// Set on a successful TOTP step-up; NULL until this session re-authenticated.
  stepupAt      DateTime?      @map("stepup_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?        @map("revoked_reason")
  ipHash        String?        @map("ip_hash")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  /// Set when the whole chain is revoked (logout, reuse detection, device mismatch).
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// TOTP second factor. At most one credential per user.
/// `secretEnc` only ever holds the versioned ciphertext envelope (`v1...`),
/// enforced by a CHECK constraint in the migration.
model TotpCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  /// NULL until the user proves possession of the secret with a valid code.
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Highest accepted time step, so a code cannot be replayed inside its window.
  lastUsedStep BigInt    @default(0) @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_credentials")
}

/// Single-use recovery codes, stored as sha256 hex only (the plaintext code
/// lives only in the response that generated it).
model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("recovery_codes")
}

/// The closed set of in-site notifications. The client's message catalog has a
/// sentence for each kind and each enum param value, so the server stores no
/// text of its own and nothing it writes can reach the page verbatim.
enum NotificationKind {
  profile_under_review
  profile_approved
  profile_rejected
  upload_status
  subscription_status
}

/// One in-site inbox row per thing the owner should see. The row names no
/// person and carries no free text: the owner is the subject, `kind` is closed
/// and `params` holds enum values only. `readAt` is the whole read state - an
/// unread row is simply a row whose `readAt` is still NULL.
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  params    Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The inbox reads newest first and counts unread per owner.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  NONE
  PENDING
  ACTIVE
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  NOWPAYMENTS
  PAYPAL
}

enum PaymentStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  CHARGEBACK
}

/// One subscription per user and competition period. The runtime role has no
/// DELETE privilege on this table.
model Subscription {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  periodKey String             @map("period_key")
  status    SubscriptionStatus @default(NONE)
  startsAt  DateTime?          @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([userId, periodKey])
  @@index([userId])
  @@map("subscriptions")
}

/// A provider payment against a subscription. The expected terms and provider
/// identifiers are immutable after insert (enforced by a migration trigger).
model Payment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId    String          @map("subscription_id") @db.Uuid
  provider          PaymentProvider
  providerPaymentId String          @map("provider_payment_id")
  expectedAmount    Decimal         @map("expected_amount") @db.Decimal(18, 6)
  expectedCurrency  String          @map("expected_currency")
  expectedNetwork   String?         @map("expected_network")
  paidAmount        Decimal?        @map("paid_amount") @db.Decimal(18, 6)
  status            PaymentStatus   @default(CREATED)
  confirmedAt       DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId])
  @@map("payments")
}

/// Webhook idempotency record. Only the payload digest is stored - never the
/// raw body, headers or secrets.
model WebhookEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       PaymentProvider
  eventId        String          @map("event_id")
  payloadHash    String          @map("payload_hash")
  signatureValid Boolean         @map("signature_valid")
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(6)
  outcome        String?

  @@unique([provider, eventId])
  @@map("webhook_events")
}

/// The priced offer the checkout sells. A row is never deleted and the price is
/// kept as a decimal, so no floating-point value ever describes money.
model BillingPlan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique
  periodKey  String   @map("period_key")
  priceUsd   Decimal  @map("price_usd") @db.Decimal(18, 6)
  periodDays Int      @map("period_days")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_plans")
}

/// One account following one athlete profile.
///
/// The unique pair (follower, profile) makes a repeated follow a no-op at the
/// database, not only in the service. Both sides cascade: deleting an account or
/// a profile removes the follow rows that named it. No column ever describes who
/// follows whom beyond the pair itself, and the API only reads counts from it.
model AthleteFollow {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerUserId    String         @map("follower_user_id") @db.Uuid
  followedProfileId String         @map("followed_profile_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  follower          User           @relation("AthleteFollowFollower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followedProfile   AthleteProfile @relation("AthleteFollowFollowed", fields: [followedProfileId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, followedProfileId])
  /// Counting the followers of one profile is the only aggregate read.
  @@index([followedProfileId])
  @@map("athlete_follows")
}

/// One account liking one public profile photo.
///
/// The unique pair (photo, user) makes a repeated like a no-op at the database.
/// A like is withdrawn with DELETE, so the runtime role may delete these rows,
/// and only these: a photo itself is never deleted by the app.
model PhotoLike {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoId   String       @map("photo_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  photo     ProfilePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  /// Counting the likes of one photo is the only aggregate read.
  @@index([photoId])
  @@map("photo_likes")
}

/// One competition result a staff member entered for one athlete profile.
///
/// The score is never supplied by the athlete: only a staff route writes this
/// row, and `enteredById` records who did. Points are an integer with a
/// 0..1000 CHECK in the migration, so a bad value cannot be stored even if a
/// future caller skips the DTO.
model CompetitionResult {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athleteProfileId String         @map("athlete_profile_id") @db.Uuid
  eventName        String         @map("event_name") @db.VarChar(120)
  eventDate        DateTime       @map("event_date") @db.Date
  points           Int
  enteredById      String         @map("entered_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  enteredBy        User           @relation("CompetitionResultEnteredBy", fields: [enteredById], references: [id], onDelete: Cascade)

  /// Listing the results of one athlete is the only filtered read.
  @@index([athleteProfileId])
  @@map("competition_results")
}

/// The derived leaderboard row for one athlete profile.
///
/// It is never written by a client: the ranking service recomputes it from the
/// approved athletes' results inside the same transaction as the change, behind
/// an advisory lock. The primary key is the profile id, so one profile has at
/// most one row. The descending index serves the leaderboard read.
model AthleteRanking {
  athleteProfileId String         @id @map("athlete_profile_id") @db.Uuid
  totalPoints      Int            @map("total_points")
  rank             Int
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@index([totalPoints(sort: Desc)])
  @@map("athlete_rankings")
}

enum CompanyKind {
  ORGANIZER
  SPONSOR
  PARTNER
  OTHER
}

/// One staff-maintained company profile: the "identity card" of an organizer,
/// sponsor, partner or other organization.
///
/// The columns are split in two on purpose:
///
/// - the public face - `slug`, `displayName`, `country`, `kind`, `description`
///   and `websiteUrl` - is everything a later public read may ever show;
/// - the legal identity from `legalName` down is staff-only, because a sole
///   proprietorship's legal name is a natural person's name. No public query
///   selects these columns, and this route set is `@Roles(ADMIN, OWNER)` only.
///
/// `slug` carries a plain unique index, so uniqueness also covers soft-deleted
/// rows: a retired slug can never be reused to impersonate a company.
/// `deletedAt` is the only deletion this table has; the row and its trail stay.
///
/// Format rules (slug, country, https URL, MERSIS, NACE) are CHECK constraints
/// in prisma/migrations/20261128120000_company_profile/migration.sql, so a
/// future caller that skips the DTO still cannot store a malformed value.
model Company {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase `[a-z0-9-]`, 3-60 characters; immutable after creation.
  slug                String      @unique @db.VarChar(60)
  displayName         String      @map("display_name") @db.VarChar(120)
  /// ISO 3166-1 alpha-2, uppercase.
  country             String      @db.VarChar(2)
  kind                CompanyKind
  /// Public activity summary. Plain text only.
  description         String?     @db.VarChar(2000)
  /// https only, no IP literal and no local/private host; bounded at 300.
  websiteUrl          String?     @map("website_url") @db.VarChar(300)

  // Staff-only from here down: never selected by a public read.
  legalName           String      @map("legal_name") @db.VarChar(200)
  tradeRegistryNumber String?     @map("trade_registry_number") @db.VarChar(20)
  mersisNumber        String?     @map("mersis_number") @db.VarChar(16)
  taxNumber           String?     @map("tax_number") @db.VarChar(20)
  taxOffice           String?     @map("tax_office") @db.VarChar(120)
  chamberName         String?     @map("chamber_name") @db.VarChar(200)
  chamberRegisteredAt DateTime?   @map("chamber_registered_at") @db.Date
  /// NACE code as `12.34.56`.
  naceCode            String?     @map("nace_code") @db.VarChar(8)
  address             String?     @db.VarChar(500)
  contactEmail        String?     @map("contact_email") @db.VarChar(254)

  /// Attribution only, like `AuditLog.actorId`: deliberately no foreign key, so
  /// a staff account change can never cascade into a company row.
  createdById         String      @map("created_by_id") @db.Uuid
  updatedById         String      @map("updated_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete: set once, never cleared. NULL means the company is live.
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)

  /// The staff list is newest first and pages by (createdAt, id).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("companies")
}
